// Renovate configuration for 2AMLogic/sg13g2-vco
// Docs: https://docs.renovatebot.com/configuration-options/
// Pipeline docs (upstream): noc0dev-template's docs/ops/dependency-security-pipeline.md
// (not vendored into this repo)
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Extend recommended defaults, plus security-focused presets
  "extends": [
    "config:recommended",
    "security:openssf-scorecard",
    ":dependencyDashboard"
  ],

  // Override Mend-hosted "silent" default (applied when app is installed on
  // "All repositories").  "full" lets Renovate create branches, PRs, and the
  // Dependency Dashboard issue.
  "mode": "full",

  // --- Supply chain security ---

  // 14-day quarantine: do not propose updates until 14 days after release.
  // This lets registries catch and yank malicious packages before we see them.
  // Ref: https://docs.renovatebot.com/key-concepts/minimum-release-age/
  "minimumReleaseAge": "14 days",

  // Flag known vulnerabilities from the OSV database
  "osvVulnerabilityAlerts": true,

  // --- Merge policy ---

  // Never auto-merge. Agents review, humans merge.
  "automerge": false,

  // Create PRs as drafts — keeps dependency PRs out of the merge-ready
  // queue until reviewed (template convention, not an AGENTS.md mandate —
  // this repo has no written PR policy)
  "draftPR": true,

  // --- Schedule ---

  // Weekly on Monday mornings (UTC). Security/vulnerability PRs bypass
  // both this schedule and minimumReleaseAge (Renovate built-in behavior).
  // Ref: https://docs.renovatebot.com/key-concepts/minimum-release-age/
  // "Security updates bypass any minimumReleaseAge checks"
  "schedule": ["before 10am on monday"],
  "timezone": "UTC",

  // --- Python (uv) ---
  // Template default from noc0dev-template: inert in this repo until a
  // pyproject.toml/uv.lock exists. The pep621/uv packageRules below are
  // likewise no-ops today.

  // Refresh uv.lock even when no direct dependency range changes.
  // This is how Renovate keeps transitive dependencies current.
  // Match the repo's Monday morning schedule explicitly; Renovate otherwise
  // applies a separate lock-file-maintenance default schedule.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on monday"]
  },

  // --- PR behavior ---

  // Limit concurrent PRs to keep review queue manageable
  "prConcurrentLimit": 5,

  // Add changelogs to PR body for agent review
  "fetchChangeLogs": true,

  // --- Package grouping ---

  "packageRules": [
    // Group all non-major Python dependency updates into one PR.
    // rangeStrategy is scoped here (not top-level): per Renovate docs,
    // "update-lockfile" only applies to a fixed list of managers that does
    // not include github-actions, the only manager with anything to update
    // in this repo today. Update lockfile without widening pyproject.toml
    // version ranges; Renovate detects uv.lock natively.
    {
      "groupName": "python minor/patch dependencies",
      "matchManagers": ["pep621", "uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "rangeStrategy": "update-lockfile"
    },

    // Python major updates get individual PRs (more risk, need individual review)
    {
      "matchManagers": ["pep621", "uv"],
      "matchUpdateTypes": ["major"],
      "rangeStrategy": "update-lockfile"
    },

    // Group all GitHub Actions SHA updates into one PR
    // Template convention (not an AGENTS.md mandate — this repo currently
    // pins by tag, e.g. actions/checkout@v4): pin by SHA with inline
    // version comments (# vX.Y.Z).
    // Renovate preserves these comments natively when updating digests
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },

    // GitHub Actions major updates get individual PRs
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"]
    }

    // Note: security/vulnerability PRs bypass both schedule and
    // minimumReleaseAge by default (Renovate built-in behavior).
    // Ref: https://docs.renovatebot.com/key-concepts/minimum-release-age/
    // No packageRule needed — vulnerabilityAlerts config below handles it.
  ],

  // --- Ignored paths ---

  // Don't touch vendored dependencies (submodules)
  "ignorePaths": [
    "vendor/**",
    ".claude/**",
    "infra/pulumi/**"
  ],

  // --- Vulnerability alerts ---

  "vulnerabilityAlerts": {
    "enabled": true
  }
}
