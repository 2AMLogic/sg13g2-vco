   "unit": "V",
   "spice": ".meas tran vcm_min MIN v(vcm) FROM=5n TO=10n"
  },
  {
   "name": "isup_avg",
   "unit": "A",
   "spice": ".meas tran isup_avg AVG i(vsup) FROM=5n TO=10n"
  },
  {
