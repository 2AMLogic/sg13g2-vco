{
 "netlist": "vco_noise_tank_body.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "ihp-sg13g2",
  "lib": "libs.tech/ngspice/models/cornerMOShv.lib"
 },
 "corners": {
  "process": [
   {
    "name": "tt_typ_typ",
    "sections": [
     {
      "section": "hbt_typ",
      "lib": "libs.tech/ngspice/models/cornerHBT.lib"
     },
     {
      "section": "mos_tt",
      "lib": "libs.tech/ngspice/models/cornerMOShv.lib"
     },
     {
      "section": "cap_typ",
      "lib": "libs.tech/ngspice/models/cornerCAP.lib"
     }
    ]
   }
  ],
  "supply_v": {
   "vct": [
    1.65
   ]
  },
  "temperature_c": [
   27
  ]
 },
 "analysis": {
  "kind": "noise",
  "args": "v(OUTP,OUTN) IPROBE lin 7 3e9 9e9"
 },
 "measurements": [
  {
   "name": "inoise_0",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[0]"
  },
  {
   "name": "inoise_1",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[1]"
  },
  {
   "name": "inoise_2",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[2]"
  },
  {
   "name": "inoise_3",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[3]"
  },
  {
   "name": "inoise_4",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[4]"
  },
  {
   "name": "inoise_5",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[5]"
  },
  {
   "name": "inoise_6",
   "unit": "A/sqrt(Hz)",
   "expr": "inoise_spectrum[6]"
  }
 ],
 "options": {
  "timeout_s": 3000,
  "keep_artifacts": true,
  "stage_model_inputs": false,
  "osdi_preload": [
   "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi"
  ]
 }
}
